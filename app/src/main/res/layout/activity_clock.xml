<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#121212" android:padding="20dp" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الساعة والمنبه" android:textSize="24sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="30dp"/><TextClock android:id="@+id/textClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="hh:mm:ss a" android:format24Hour="HH:mm:ss" android:textSize="60sp" android:textColor="#4CAF50" android:textStyle="bold" android:layout_marginBottom="10dp"/><TextView android:id="@+id/tvDateClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جاري التحميل..." android:textSize="18sp" android:textColor="#AAAAAA" android:layout_marginBottom="40dp"/><Button android:id="@+id/btnAddAlarm" android:layout_width="match_parent" android:layout_height="60dp" android:text="إضافة منبه جديد (+)" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#E91E63" android:layout_marginBottom="20dp"/><ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/llAlarmsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"></LinearLayout></ScrollView></LinearLayout>
